// GARDE DE LA PAGE VOTE : il faut une photo de profil et le genre renseigne pour noter
'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';
import { supabase } from '@/lib/supabase';

type Status = 'loading' | 'ok' | 'no-photo' | 'no-gender';

export default function VoteLayout({ children }: { children: React.ReactNode }) {
  const [status, setStatus] = useState<Status>('loading');

  useEffect(() => {
    const checkProfile = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) {
        setStatus('ok');
        return;
      }

      const { data: photo } = await supabase
        .from('photos')
        .select('id')
        .eq('user_id', user.id)
        .limit(1)
        .maybeSingle();

      if (!photo) {
        setStatus('no-photo');
        return;
      }

      const { data: profileRow } = await supabase
        .from('profiles')
        .select('gender')
        .eq('id', user.id)
        .maybeSingle();

      setStatus(profileRow?.gender ? 'ok' : 'no-gender');
    };

    checkProfile();
  }, []);

  if (status === 'loading') {
    return <div className="flex justify-center items-center h-64">Chargement...</div>;
  }

  if (status === 'no-photo' || status === 'no-gender') {
    const noPhoto = status === 'no-photo';

    return (
      <div className="max-w-md mx-auto py-16 px-4">
        <div className="bg-white text-gray-800 rounded-xl p-8 shadow-lg text-center">
          <h1 className="text-xl font-bold mb-3">
            {noPhoto ? 'Ajoute ta photo pour noter 📸' : 'Renseigne ton genre pour commencer à noter'}
          </h1>
          <p className="text-gray-600 mb-6">
            {noPhoto
              ? "Pour noter les autres, tu dois d'abord avoir une photo de profil. C'est le principe : on note, et on est noté."
              : "Indique si tu es un homme ou une femme dans ton profil : c'est nécessaire pour te proposer les bonnes photos."}
          </p>
          <Link
            href="/profile"
            className="inline-block px-6 py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition"
          >
            {noPhoto ? 'Aller à mon profil' : 'Compléter mon profil'}
          </Link>
        </div>
      </div>
    );
  }

  return <>{children}</>;
}